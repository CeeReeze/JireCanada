# Stack jire : modèle de .env, rendu par scripts/render-env.sh (`op inject`).
# Uniquement des références au coffre 1Password « JireEnv » (jamais HomelabEnv).
# Les valeurs non secrètes (chemins, URL, fuseau) ont des défauts dans docker-compose.yml
# et se surchargent en les ajoutant au .env rendu si besoin.

# ── Bases de données ──
POSTGRES_ROOT_PASSWORD=op://JireEnv/postgres/root-password
MARIADB_ROOT_PASSWORD=op://JireEnv/mariadb/root-password
N8N_DB_PASSWORD=op://JireEnv/n8n/db-password
DOCUMENSO_DB_PASSWORD=op://JireEnv/documenso/db-password
CALDIY_DB_PASSWORD=op://JireEnv/caldiy/db-password
ESPOCRM_DB_PASSWORD=op://JireEnv/espocrm/db-password
INVOICENINJA_DB_PASSWORD=op://JireEnv/invoiceninja/db-password
NEXTCLOUD_DB_PASSWORD=op://JireEnv/nextcloud/db-password

# ── Applications ──
ESPOCRM_ADMIN_PASSWORD=op://JireEnv/espocrm/admin-password
N8N_ENCRYPTION_KEY=op://JireEnv/n8n/encryption-key
NEXTCLOUD_ADMIN_PASSWORD=op://JireEnv/nextcloud/admin-password
INVOICENINJA_APP_KEY=op://JireEnv/invoiceninja/app-key
INVOICENINJA_ADMIN_PASSWORD=op://JireEnv/invoiceninja/admin-password
DOCUMENSO_NEXTAUTH_SECRET=op://JireEnv/documenso/nextauth-secret
DOCUMENSO_ENCRYPTION_KEY=op://JireEnv/documenso/encryption-key
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=op://JireEnv/documenso/encryption-secondary-key
DOCUMENSO_SIGNING_PASSPHRASE=op://JireEnv/documenso/signing-passphrase
CALDIY_NEXTAUTH_SECRET=op://JireEnv/caldiy/nextauth-secret
CALDIY_ENCRYPTION_KEY=op://JireEnv/caldiy/encryption-key

# ── Webhook du site → n8n (même secret que LEAD_WEBHOOK_SECRET sur Vercel) ──
LEAD_WEBHOOK_SECRET=op://JireEnv/lead-webhook/secret

# ── Relais SMTP Google Workspace : DÉSACTIVÉ pendant le test (tout passe par mailpit) ──
# Pour l'activer après la phase de test, il faudra aussi changer les hôtes SMTP
# des services dans docker-compose.yml (mailpit:1025 → smtp-relay.gmail.com:587).
# SMTP_RELAY_HOST=smtp-relay.gmail.com
# SMTP_RELAY_PORT=587
# SMTP_RELAY_USER=op://JireEnv/google-smtp-relay/username
# SMTP_RELAY_PASSWORD=op://JireEnv/google-smtp-relay/password
